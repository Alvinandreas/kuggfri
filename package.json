{
  "name": "kuggfri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:unit": "npm run typecheck && npm run lint && npm run test",
    "verify": "npm run verify:unit && npm run test:e2e",
    "seed:build": "tsx scripts/build-seed.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "npm run seed:build && supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "deploy:sql": "bash -c \"mkdir -p supabase/deploy && { echo \"-- GENERERAD: alla migrationer + seed i en fil, för ett NYTT Supabase-projekt (SQL-editorn).\"; for f in supabase/migrations/*.sql; do echo \"-- ===== $f =====\"; cat \"$f\"; echo; done; echo \"-- ===== supabase/seed.sql =====\"; cat supabase/seed.sql; } > supabase/deploy/full.sql\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "katex": "^0.18.7",
    "next": "15.5.25",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
